APP_ENV=development

API_HOST=0.0.0.0
API_PORT=8080
API_BASE_URL=http://127.0.0.1:45274
ENABLE_DEV_ENDPOINTS=false
ADMIN_API_TOKEN=
ADMIN_API_TOKENS_JSON=
API_ALLOWED_ORIGINS=http://127.0.0.1:45274
API_REQUEST_TIMEOUT_SECONDS=30
API_PROJECT_IMPORT_TIMEOUT_SECONDS=7200
API_GIT_IMPORT_TIMEOUT_SECONDS=1800
API_MAX_REQUEST_BODY_BYTES=1048576
PUBLIC_BASE_URL=http://127.0.0.1:45274
REQUIRE_EMAIL_VERIFICATION=false
EMAIL_DELIVERY_WEBHOOK_URL=
DATABASE_POOL_SIZE=16
POSTGRES_HOST_PORT=15533
MODEL_API_KEY=

# Per-Human Harness provisioning.
# Local development defaults to self_hosted; use official with HARNESS_BASE_URL, or disabled to opt out.
HARNESS_MODE=self_hosted
HARNESS_BASE_URL=
HARNESS_PUBLIC_BASE_URL=
HARNESS_SPACE_PREFIX=u-
HARNESS_REQUEST_TIMEOUT_SECONDS=15
HARNESS_CREDENTIALS_ROOT=.relay/harness-credentials
# Host directory bind-mounted into the Docker Server for per-user Harness credentials.
RELAY_HARNESS_CREDENTIALS_ROOT=.relay/harness-credentials
RELAY_MESSAGE_ATTACHMENTS_ROOT=.relay/attachments
# Self-hosted Docker settings (used by ./scripts/start_docker.sh --harness self-hosted).
HARNESS_IMAGE=harness/harness:latest
HARNESS_HOST_PORT=13101
HARNESS_SSH_PORT=13123
HARNESS_ADMIN_EMAIL=admin@relay.local
HARNESS_ADMIN_PASSWORD=change-me-harness-admin
HARNESS_GIT_BASE_URL=http://127.0.0.1:13101/git
HARNESS_SSH_PUBLIC_HOST=127.0.0.1
HARNESS_GITSPACE_ENABLE=true
HARNESS_CI_ENABLED=true

MCP_AGENT_KEY=replace-me
MCP_API_BASE_URL=http://127.0.0.1:45274
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1,0.0.0.0,server
MCP_ALLOWED_ORIGINS=
PG_CONTAINER=ai-chat-postgres

# Local Codex Agent Trigger (run on the host that owns Codex and project paths)
AGENT_TRIGGER_MCP_URL=http://127.0.0.1:45274/mcp
AGENT_TRIGGER_MCP_SERVER_NAME=relay_company
AGENT_TRIGGER_CODEX_BIN=codex
AGENT_TRIGGER_CODEX_PREFIX_ARGS_JSON=[]
AGENT_TRIGGER_CODEX_ENV_ALLOWLIST=PATH,HOME,USER,LOGNAME,SHELL,TMPDIR,LANG,LC_ALL,LC_CTYPE,CODEX_HOME,HTTP_PROXY,HTTPS_PROXY,NO_PROXY
AGENT_TRIGGER_CODEX_SENSITIVE_ENV_NAMES=CODEX_API_KEY,OPENAI_API_KEY
AGENT_TRIGGER_CODEX_AUTO_COMPACT_TOKEN_LIMIT=200000
AGENT_TRIGGER_POLL_INTERVAL_SECONDS=2
AGENT_TRIGGER_BATCH_SIZE=10
AGENT_TRIGGER_INSTANCE_ID=
# Stable host-level identity used by the Codex CLI plugin catalog and operation queue.
# Keep this stable across Trigger restarts when multiple hosts connect to the same Relay database.
AGENT_TRIGGER_PLUGIN_HOST_ID=
AGENT_TRIGGER_RUN_ONCE=false
AGENT_TRIGGER_GENERAL_WORKSPACE_ROOT=/tmp/relay-agent-trigger/general
# Default organization-managed project root. When empty, Relay uses ~/.relay/companies/<company-id>.
RELAY_DEFAULT_WORKSPACE_ROOT=
# Host directory exposed read-only to the Docker Server for "input local path" imports.
# Local start scripts default this to the parent directory of the Relay checkout.
RELAY_HOST_IMPORT_ROOT=
RELAY_HOST_IMPORT_CONTAINER_ROOT=
HUMAN_FOLDER_REFERENCE_HOST_ROOT=
HUMAN_FOLDER_REFERENCE_MOUNT_ROOT=
# Shared root used to generate a project workspace path when Human leaves the advanced path blank.
AGENT_TRIGGER_MANAGED_PROJECTS_ROOT=/tmp/relay-agent-trigger/projects
AGENT_TRIGGER_ALLOWED_LOCAL_ROOTS=
# Required to attach host folder references. Defaults to AGENT_TRIGGER_ALLOWED_LOCAL_ROOTS.
HUMAN_FOLDER_REFERENCE_ALLOWED_ROOTS=
AGENT_TRIGGER_ALLOWED_GIT_HOSTS=
AGENT_TRIGGER_GIT_AUTH_PROFILES_JSON={}
AGENT_TRIGGER_GIT_CREDENTIALS_ROOT=.relay-agent-trigger/git-credentials
AGENT_TRIGGER_STATE_ROOT=.relay-agent-trigger
AGENT_TRIGGER_CODEX_CONTROL_ROOT=.relay-agent-trigger/codex-control
AGENT_TRIGGER_MODEL_CATALOG_PATH=.relay-agent-trigger/codex-models.json
# Relay-managed Chrome DevTools MCP. The launcher builds this image automatically.
RELAY_CHROME_DEVTOOLS_MCP_ENABLED=true
RELAY_CHROME_DEVTOOLS_MCP_IMAGE=relay/chrome-devtools-mcp:1.6.0
RELAY_CHROME_PROFILE_ROOT=.relay-agent-trigger/browser-profiles
AGENT_TRIGGER_MODEL_DISCOVERY_PROFILES=default
AGENT_TRIGGER_MODEL_DISCOVERY_INTERVAL_SECONDS=900
# Re-check the Trigger host's existing Codex login so the console reflects external login changes.
AGENT_TRIGGER_CODEX_AUTH_DISCOVERY_INTERVAL_SECONDS=60
# Refresh `codex mcp list --json` for the default and managed Codex homes.
AGENT_TRIGGER_MCP_DISCOVERY_INTERVAL_SECONDS=60
AGENT_TRIGGER_PLUGIN_DISCOVERY_INTERVAL_SECONDS=300
# When true, a missing Codex CLI is installed by the host Trigger with OpenAI's official script.
# When false, Human can request installation from the Codex console.
AGENT_TRIGGER_CODEX_AUTO_INSTALL=false
# Optional override. Leave empty to select OpenAI's official installer automatically:
# macOS/Linux -> install.sh; native Windows -> install.ps1.
AGENT_TRIGGER_CODEX_INSTALL_URL=
# Update checks only publish a console prompt. An update runs only after Human confirms it.
AGENT_TRIGGER_CODEX_UPDATE_REGISTRY_URL=https://registry.npmjs.org/@openai%2Fcodex/latest
AGENT_TRIGGER_CODEX_UPDATE_CHECK_INTERVAL_SECONDS=3600

# Optional managed Git provider. When enabled, authorized Agents can create a repository and
# a project-specific credential through company.project create/git_provision.
RELAY_GIT_PROVIDER_KIND=
RELAY_GIT_PROVIDER_BASE_URL=
# Optional public HTTPS base used for clone URLs when Gitness reports an internal URL.
RELAY_GIT_PROVIDER_CLONE_BASE_URL=
RELAY_GIT_PROVIDER_PARENT_REF=
RELAY_GIT_PROVIDER_USERNAME=
RELAY_GIT_PROVIDER_TOKEN=
# macOS local-dev helper: start_dev.sh can read the provider token from Keychain instead.
RELAY_GIT_PROVIDER_TOKEN_KEYCHAIN_SERVICE=

DATABASE_URL=postgres://postgres:postgres@127.0.0.1:15533/ai_chat
