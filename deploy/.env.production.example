DATABASE_URL=postgres://postgres:replace-me@postgres:5432/ai_chat
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=ai_chat
# Host directory shared by the Server and the host Agent Trigger.
AGENT_TRIGGER_STATE_ROOT=./.relay-agent-trigger
AGENT_TRIGGER_MANAGED_PROJECTS_ROOT=/tmp/relay-agent-trigger/projects

PUBLIC_HTTP_PORT=18181
PUBLIC_BASE_URL=https://agents.example.com
API_ALLOWED_ORIGINS=https://agents.example.com
MCP_ALLOWED_HOSTS=agents.example.com,server
MCP_ALLOWED_ORIGINS=https://agents.example.com

# Keep this only as a bootstrap/root credential, or leave empty and use scoped tokens below.
ADMIN_API_TOKEN=
ADMIN_API_TOKENS_JSON=[{"name":"observer","token":"replace-with-a-32-byte-read-token","scopes":["admin:read"]},{"name":"operator","token":"replace-with-a-32-byte-ops-token","scopes":["admin:read","admin:agents"]}]

REQUIRE_EMAIL_VERIFICATION=true
EMAIL_DELIVERY_WEBHOOK_URL=https://mailer.example.com/hooks/ai-chat

HARNESS_MODE=disabled
HARNESS_BASE_URL=
HARNESS_PUBLIC_BASE_URL=
HARNESS_ADMIN_EMAIL=admin@relay.local
HARNESS_ADMIN_PASSWORD=replace-with-a-long-random-password

API_REQUEST_TIMEOUT_SECONDS=30
API_MAX_REQUEST_BODY_BYTES=1048576

RUST_LOG=info,tower_http=info
