FROM rust:1.94-bookworm AS builder

WORKDIR /app

ENV CARGO_NET_RETRY=10 \
    CARGO_HTTP_TIMEOUT=120 \
    CARGO_HTTP_MULTIPLEXING=false

COPY Cargo.toml Cargo.lock ./
COPY apps ./apps
COPY crates ./crates
COPY skills ./skills

RUN --mount=type=cache,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,target=/app/target,sharing=locked \
    cargo build --locked --release -p ai-chat-server \
    && cp /app/target/release/ai-chat-server /app/ai-chat-server

FROM postgres:16-bookworm AS migrator

WORKDIR /app

COPY migrations /app/migrations
COPY scripts/run_pg_migrations.sh /app/scripts/run_pg_migrations.sh

RUN chmod +x /app/scripts/run_pg_migrations.sh

FROM debian:bookworm-slim

WORKDIR /app

COPY --from=builder /app/ai-chat-server /usr/local/bin/ai-chat-server
COPY --from=builder /app/apps/web/dist /app/web-dist
COPY --from=builder /usr/bin/git /usr/bin/git
COPY --from=builder /usr/lib/git-core /usr/lib/git-core
COPY --from=builder /usr/share/git-core /usr/share/git-core

EXPOSE 8080

CMD ["ai-chat-server"]
