FROM node:22-bookworm AS web-builder

WORKDIR /app

ARG PNPM_VERSION=8.15.9

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/web/package.json ./apps/web/package.json

RUN corepack enable && corepack prepare pnpm@${PNPM_VERSION} --activate
RUN pnpm install --frozen-lockfile

COPY apps/web ./apps/web
COPY skills ./skills

ARG VITE_API_BASE_URL=
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

RUN pnpm --dir apps/web build

FROM rust:1.94-bookworm AS builder

WORKDIR /app

COPY Cargo.toml Cargo.lock ./
COPY apps ./apps
COPY crates ./crates
COPY skills ./skills
COPY --from=web-builder /app/apps/web/dist ./apps/web/dist

RUN cargo build --release -p ai-chat-server

FROM postgres:16-bookworm AS migrator

WORKDIR /app

COPY migrations /app/migrations
COPY scripts/run_pg_migrations.sh /app/scripts/run_pg_migrations.sh

RUN chmod +x /app/scripts/run_pg_migrations.sh

FROM debian:bookworm-slim

WORKDIR /app

COPY --from=builder /app/target/release/ai-chat-server /usr/local/bin/ai-chat-server
COPY --from=builder /app/apps/web/dist /app/web-dist
COPY --from=builder /usr/bin/git /usr/bin/git
COPY --from=builder /usr/lib/git-core /usr/lib/git-core
COPY --from=builder /usr/share/git-core /usr/share/git-core

EXPOSE 8080

CMD ["ai-chat-server"]
